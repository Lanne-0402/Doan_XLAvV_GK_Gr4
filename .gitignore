# Byte-compiled / optimized / DLL files (Python cache)
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables & sensitive local configs
.env
.env.*
*.key
*.pem
secrets.json
local_settings.py

# IDE & Editor settings (chứa đường dẫn cá nhân trên máy)
.vscode/
.idea/
*.swp
*.swo

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS generated files (Windows / macOS)
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Build / packaging / logs
build/
dist/
*.egg-info/
*.log
